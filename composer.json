{
    "name": "vaneetjoshi/laravel-utilities",
    "description": "Foundational ecosystem primitives providing Action/Filter hooks, key-value Options storage, Date/Currency formatting utilities, and Widget Engine.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vaneet Joshi",
            "homepage": "https://vaneetjoshi.github.io",
            "role": "Developer",
            "email": "vaneetjoshi@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Vaneetjoshi\\LaravelUtilities\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vaneetjoshi\\LaravelUtilities\\LaravelUtilitiesServiceProvider"
            ],
            "aliases": {
                "Options": "Vaneetjoshi\\LaravelUtilities\\Facades\\Options",
                "Hooks": "Vaneetjoshi\\LaravelUtilities\\Facades\\Hooks",
                "Format": "Vaneetjoshi\\LaravelUtilities\\Facades\\Format",
                "Widgets": "Vaneetjoshi\\LaravelUtilities\\Facades\\Widgets",
                "Navbars": "Vaneetjoshi\\LaravelUtilities\\Facades\\Navbars"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}